# Kopiraj u .env i popuni. .env se ne sprema u repozitorij.

# Obavezno — bez ovoga obrazac za upit vraća grešku.
# Ključ se generira na resend.com (Settings -> API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Neobavezno — adresa na koju stižu upiti.
# Zadano: brickupdoo@gmail.com
LEAD_NOTIFY_EMAIL=

# Neobavezno — adresa s koje se šalje.
# Zadano: Verdia <onboarding@resend.dev> (radi samo dok je LEAD_NOTIFY_EMAIL
# ista adresa kojom je otvoren Resend račun; za vlastitu domenu je treba
# verificirati na Resendu).
LEAD_FROM_EMAIL=

# Neobavezno — puna adresa stranice bez kose crte na kraju.
# Koristi se za canonical oznaku, sitemap.xml i strukturirane podatke.
# Ako se ne postavi, koristi se vrijednost iz src/lib/site.ts.
SITE_URL=https://brickup.hr

# --- Admin panel (admin.brickup.hr) ---
# Prijava osnivača: korisničko ime (zadano "admin") i zajednička lozinka.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Supabase projekt s tablicama iz supabase/migrations/.
# Project Settings -> API. Service role ključ NIKAD ne stavljaj u klijentski kod.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Google kalendari za karticu Kalendar: Google Calendar -> Postavke ->
# odaberi kalendar -> "Tajna adresa u iCal formatu" (.ics). Samo čitanje.
# Luka Posavac
GCAL_ICS_OSNIVAC_1=
# Zvonimir Kišurek
GCAL_ICS_OSNIVAC_2=
# Neobavezno — zajednički kalendar poslova.
GCAL_ICS_POSLOVI=
